#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(pwd)"

PROJECT_BASE="$(basename "$PROJECT_DIR" \
  | tr '[:upper:]' '[:lower:]' \
  | tr -cs '[:alnum:]_-' '-' \
  | sed 's/^-//; s/-$//')"

PROJECT_HASH="$(printf '%s' "$PROJECT_DIR" | sha1sum | cut -c1-8)"
PROJECT_SLUG="${PROJECT_BASE}-${PROJECT_HASH}"

export PROJECT_DIR
export PROJECT_SLUG

mkdir -p "$HOME/.config/claude-code/projects/$PROJECT_SLUG/home"

docker compose \
  -f "$HOME/.config/claude-container/docker-compose.yml" \
  -p "claude-$PROJECT_SLUG" \
  run --rm claude

